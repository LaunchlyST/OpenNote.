# Copy to mail.env (git-ignored). Use YOUR values — nothing here is real.
MAIL_DOMAIN=yourdomain.com
MAIL_HOSTNAME=mail.yourdomain.com
# Folder with fullchain.pem + privkey.pem for MAIL_HOSTNAME (Let's Encrypt).
TLS_DIR=/etc/letsencrypt/live/mail.yourdomain.com
# Folder with opennote.private.pem from `npm run mail:dns`.
DKIM_DIR=../../data/dkim

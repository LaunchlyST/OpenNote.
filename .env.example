# Copy to .env and fill in. Never commit .env.

# Public URL the site is served from (no trailing slash).
BETTER_AUTH_URL=http://localhost:5173
# 32+ random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# SQLite database file (free, no account needed).
DATABASE_PATH=data/opennote.db
# Port for the API server (Vite proxies /api to it in development).
API_PORT=3001
# Extra allowed origins, comma separated (optional).
TRUSTED_ORIGINS=
# Header(s) your host's proxy sets with the visitor IP (for rate limiting),
# and the proxy addresses to trust when the header holds a chain.
IP_ADDRESS_HEADERS=x-forwarded-for,x-real-ip
TRUSTED_PROXIES=

# --- Email (verification and password reset) ---
# OpenNote's own email system. Leave SMTP_HOST empty in development: mail goes
# to a local inbox at http://localhost:5173/api/dev/mail.
# For real inboxes, point these at YOUR OWN mail server (docs/self-hosted-email.md).
# Local SMTP test: npm run mail:catcher, then SMTP_HOST=127.0.0.1 SMTP_PORT=2525
# SMTP_REQUIRE_TLS=false.
# Quickest real delivery (free, no domain): your Gmail + an app password.
#   SMTP_PRESET=gmail   SMTP_USER=you@gmail.com   SMTP_PASS=<16-letter app password>
# Steps: docs/self-hosted-email.md
SMTP_PRESET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Leave empty with SMTP_PRESET (defaults to your Gmail address). Own server: "OpenNote <no-reply@yourdomain.com>"
EMAIL_FROM=
# STARTTLS is required unless set to false (only for the loopback catcher).
SMTP_REQUIRE_TLS=true
# Optional DKIM signing by OpenNote itself (key file under data/, never committed).
DKIM_DOMAIN=
DKIM_SELECTOR=
DKIM_PRIVATE_KEY_PATH=
# Outbox limits.
MAIL_RATE_PER_HOUR=5
MAIL_MAX_ATTEMPTS=5
# Defaults to true when SMTP is configured, false otherwise.
# REQUIRE_EMAIL_VERIFICATION=true

# --- Google sign-in ("Continue with Google") ---
# Steps: docs/google-sign-in.md. Both values come from Google Cloud Console and
# are read by the server only — never put them in src/.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Administrators ---
# Comma-separated emails that get the admin role once their address is
# verified. Empty means nobody is an admin. Without SMTP, verify your own
# address with: npm run admin:verify -- you@example.com
ADMIN_EMAILS=

# --- Deployment (Admin -> Deploy) ---
# All of these are read by the API server only. None of them reach the browser.

# Label shown in the Deploy panel. One of: vercel | cloudflare-pages | netlify |
# render | fly | custom.
DEPLOY_PROVIDER=vercel
# The public https:// address the site is served from.
DEPLOY_PRODUCTION_URL=
# The provider's "rebuild and publish the latest commit" hook URL. Treat it like
# a password — it can publish the site. Create one at:
#   Vercel          -> Project -> Settings -> Git -> Deploy Hooks
#   Cloudflare Pages-> Workers & Pages -> project -> Settings -> Deploy hooks
#   Netlify         -> Site configuration -> Build & deploy -> Deploy hooks
#   Render / Fly    -> your own CI endpoint that runs the build
DEPLOY_HOOK_URL=
# Kill switch. Deployments are refused unless this is exactly "true", so a
# fresh install can never publish by accident.
DEPLOY_ENABLED=false
# Who may deploy is controlled by ADMIN_EMAILS above.

# OpenNote deployment — server environment
#
# Copy the values you need into your hosting provider's environment variables
# (Vercel: Project → Settings → Environment Variables). DO NOT commit a filled
# in copy of this file, and never put any of these in src/ — everything under
# api/ runs on the server only.

# ---------------------------------------------------------------------------
# Which provider publishes the site
# ---------------------------------------------------------------------------
# One of: vercel | cloudflare-pages | netlify | custom
DEPLOY_PROVIDER=vercel

# The public address the site is served from. Shown in Admin Settings → Deploy.
DEPLOY_PRODUCTION_URL=https://opennote.example.com

# ---------------------------------------------------------------------------
# The deployment credential
# ---------------------------------------------------------------------------
# A "deploy hook" from the provider: it rebuilds and republishes the latest
# commit on the connected branch. Create one at:
#   Vercel           → Project → Settings → Git → Deploy Hooks
#   Cloudflare Pages → Workers & Pages → your project → Settings → Deploy hooks
#   Netlify          → Site configuration → Build & deploy → Deploy hooks
# Treat this like a password: it can publish the site.
DEPLOY_HOOK_URL=

# ---------------------------------------------------------------------------
# The kill switch
# ---------------------------------------------------------------------------
# Deploys are refused unless this is exactly "true". It ships unset, so nothing
# publishes until you deliberately turn it on.
DEPLOY_ENABLED=false

# ---------------------------------------------------------------------------
# Who may deploy
# ---------------------------------------------------------------------------
# The passphrase that unlocks Admin Settings → Deploy. Kept on the server.
DEPLOY_ADMIN_PASSWORD=

# Long random string used to sign the admin session cookie.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# Optional. When set, the signed-in account's email must also appear in this
# comma-separated list. Leave unset to allow the passphrase alone.
DEPLOY_ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Optional — persistent "last deployment" record
# ---------------------------------------------------------------------------
# Serverless instances are recycled, so without a store the "last deployment"
# row only survives while an instance stays warm. An Upstash Redis database
# makes it durable. Both values are required together.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=